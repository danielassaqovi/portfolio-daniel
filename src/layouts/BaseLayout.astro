---
/**
 * Kerangka HTML halaman.
 *
 * Isi <head> dipertahankan sama seperti versi statis sebelumnya — meta,
 * Open Graph, favicon, preload font, dan satu skrip inline untuk mengganti
 * class `no-js` menjadi `js` sebelum CSS dirender — dengan tambahan meta
 * untuk pratinjau tautan (og:image, twitter card) dan canonical.
 *
 * `siteUrl` dipakai sebagai basis URL absolut. Kalau nanti dipasang domain
 * sendiri, cukup ubah satu nilai di sini (atau lewat env PUBLIC_SITE_URL).
 */
interface Props {
  title: string;
  description: string;
  ogDescription?: string;
}

const { title, description, ogDescription = description } = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://daniel-assaqovi.vercel.app').replace(/\/$/, '');
const canonical = siteUrl + Astro.url.pathname;
const ogImage = siteUrl + '/assets/img/og-cover.jpg';
---

<!doctype html>
<html lang="id" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Muhammad Daniel Assaqovi" />
    <meta name="theme-color" content="#0a0a0c" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Muhammad Daniel Assaqovi" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Muhammad Daniel Assaqovi — Full Stack Developer & QA Engineer" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="assets/img/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="assets/fonts/anton-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="assets/fonts/worksans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="assets/css/style.css" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>
